# Copy to .env and fill in YOUR OWN values. Never commit a real .env.
# No secrets are shipped in this repo. Every value below is a placeholder name, not a real key.
PORT=3000
# Random long string used to sign login tokens. Generate one yourself, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: file used for persistence. Defaults to ./data.json
DATA_FILE=./data.json
# Platform fee taken in Earn split MATH only (percent). Default 10.
# This is NOT actually charged or moved as real money until Stripe Connect is set up.
PLATFORM_FEE_PERCENT=10
# Premium subscription: paste a payment link YOU create in your own Stripe dashboard.
# Muse Stripe writes are blocked, so the owner creates this link himself. Leave empty until then.
# Example format only — do NOT use this as a link: https://buy.stripe.com/YOUR_OWN_LINK_HERE
STRIPE_PREMIUM_PAYMENT_LINK=
# Optional: Stripe price ID for Premium, if you prefer price-based checkout. Leave empty until you create it.
STRIPE_PREMIUM_PRICE_ID=
# Optional: ad network / sponsor slot identifier. Leave empty for the placeholder slot.
AD_SLOT_ID=
